---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { TOPICS, byOrder } from '../data/topics';

export async function getStaticPaths() {
  const posts = await getCollection('articulos');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'articulos'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, topic, cover, coverAlt, published, updated } = post.data;
const url = new URL(`/${post.id}/`, Astro.site).href;

const all = (await getCollection('articulos')).sort(byOrder);
const sameTopic = all.filter((p) => p.data.topic === topic && p.id !== post.id);
const idx = all.findIndex((p) => p.id === post.id);
// Siguientes en el orden de lectura del tema, dando la vuelta si hace falta
const related = [...sameTopic.filter((p) => all.indexOf(p) > idx), ...sameTopic.filter((p) => all.indexOf(p) < idx)].slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'es-AR',
    datePublished: published.toISOString().slice(0, 10),
    dateModified: updated.toISOString().slice(0, 10),
    mainEntityOfPage: url,
    publisher: { '@type': 'Organization', name: 'Colonia Menonita Guatraché', url: 'https://coloniamenonita.com/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://coloniamenonita.com/' },
      { '@type': 'ListItem', position: 2, name: TOPICS[topic].label, item: `https://coloniamenonita.com/#${topic}` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---
<Base title={`${title} | Colonia Menonita Guatraché`} description={description} image={cover} type="article" jsonLd={jsonLd}>
  <article style="display:grid;gap:32px">
    <div class="article-head">
      <nav class="crumbs" aria-label="Ruta">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href={`/#${topic}`}>{TOPICS[topic].label}</a></li>
        </ol>
      </nav>
      <h1>{title}</h1>
    </div>
    {cover && (
      <figure class="cover">
        <Image src={cover} alt={coverAlt ?? ''} widths={[400, 720, 1024]} sizes="(max-width: 760px) 100vw, 680px" loading="eager" fetchpriority="high" />
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <div class="next">
    <h2>Seguir leyendo</h2>
    <PostList posts={related} />
    <p class="small" style="margin-top:12px"><a href="/como-visitar-la-colonia-menonita/">Cómo visitar la Colonia Menonita →</a></p>
  </div>
</Base>
