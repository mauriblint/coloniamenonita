---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import fotos from '../data/fotos.json';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/img/**/*.{jpg,jpeg,JPG,png}', { eager: true });
const photos = await Promise.all(
  fotos.map(async (f, i) => {
    const img = files[`../assets/img/${f.src}`]?.default;
    if (!img) throw new Error(`Falta la foto ${f.src}`);
    const full = await getImage({ src: img, width: 1600 });
    return { img, full: full.src, alt: f.alt || `Colonia Menonita Nueva Esperanza, Guatraché: foto ${i + 1}` };
  }),
);
---
<Base
  title="Fotos de la Colonia Menonita de Guatraché, La Pampa"
  description="Fotos de la Colonia Menonita Nueva Esperanza en Guatraché, La Pampa: familias, carros a caballo, casas, chacras y la vida diaria en la colonia."
  image={photos[0].img}
>
  <div class="article-head">
    <nav class="crumbs" aria-label="Ruta"><ol><li><a href="/">Inicio</a></li></ol></nav>
    <h1>Fotos de la Colonia Menonita</h1>
    <p class="lead">
      Imágenes de la vida diaria en la Colonia Nueva Esperanza: familias, carros tirados por caballos, casas y chacras.
      Tocá una foto para verla en grande.
    </p>
  </div>
  <div class="photos">
    {photos.map((p) => (
      <a href={p.full}><Image src={p.img} alt={p.alt} width={400} height={300} fit="cover" /></a>
    ))}
  </div>
</Base>
